# ===================================================================
# CONFIGURACIÓN DEL SERVIDOR Y CREDENCIALES CENTRALIZADAS DE BREVO
# ===================================================================

# Puerto de escucha del backend
PORT=3000

# Clave secreta de la API v3 de Brevo (Obtenida en Brevo > SMTP & API > Claves API)
# NUNCA compartas esta clave ni la subas a GitHub.
BREVO_API_KEY=xkeysib-tu-clave-api-aqui

# Correo electrónico verificado en Brevo (remitente de todos los correos)
# Debe ser un remitente verificado en tu cuenta Brevo (ej. tu cuenta de inicio de sesión)
BREVO_SENDER_EMAIL=tu_correo_verificado@ejemplo.com

# Nombre visible del remitente en los correos que reciben los usuarios
BREVO_SENDER_NAME=Moto Oil Tracker

# URL(s) autorizadas del frontend para CORS (separadas por comas si son varias)
# Para desarrollo local y para GitHub Pages en producción:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080,https://usuario.github.io

# Clave secreta para generación de tokens de verificación y hashes de códigos
TOKEN_SECRET=genera_una_clave_aleatoria_segura_de_32_caracteres_minimo

# Entorno de ejecución: 'development' o 'production'
NODE_ENV=development
